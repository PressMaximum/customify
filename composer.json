{
    "name": "pressmaximum/customify",
    "description": "Customify — lightweight, SEO-optimized, multipurpose WordPress classic theme.",
    "type": "wordpress-theme",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:PressMaximum/dashboard-kit.git"
        }
    ],
    "require": {
        "php": ">=8.0",
        "pressmaximum/dashboard-kit": "*"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
